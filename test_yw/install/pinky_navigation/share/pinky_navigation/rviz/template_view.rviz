Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_displays/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.7
      Class: rviz_default_displays/Map
      Color Scheme: map
      Enabled: true
      Name: Map
      Topic:
        Value: /__ROBOT_NS__/map
      Update Topic:
        Value: /__ROBOT_NS__/map_updates
      Value: true
    - Alpha: 1
      Autoscale Value: true
      Class: rviz_default_displays/LaserScan
      Color: 255; 255; 255
      Color Transformer: Intensity
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /__ROBOT_NS__/scan
      Value: true
    - Alpha: 1
      Class: rviz_default_displays/RobotModel
      Description Topic:
        Value: /__ROBOT_NS__/robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Alpha: 1
      Class: rviz_default_displays/PoseArray
      Enabled: true
      Name: AMCL Particles
      Topic:
        Value: /__ROBOT_NS__/particlecloud
      Value: true
    - Alpha: 1
      Class: rviz_default_displays/Path
      Color: 255; 0; 0
      Enabled: true
      Name: Global Plan
      Topic:
        Value: /__ROBOT_NS__/plan
      Value: true
    - Alpha: 1
      Class: rviz_default_displays/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Local Plan
      Topic:
        Value: /__ROBOT_NS__/local_plan
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: __ROBOT_NS__/map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugin/MoveCamera
    - Class: rviz_default_plugin/Select
    - Class: rviz_default_plugin/FocusCamera
    - Class: rviz_default_plugin/Measure
    - Class: rviz_default_plugin/PublishPoint
      Topic:
        Value: /__ROBOT_NS__/clicked_point
    - Class: rviz_default_plugin/2DPoseEstimate
      Topic:
        Value: /__ROBOT_NS__/initialpose
    - Class: rviz_default_plugin/2DNavGoal
      Topic:
        Value: /__ROBOT_NS__/goal_pose
  Value: true
Window Geometry:
  Height: 800
  Width: 1200
