[Unit]
Description=Robot Camera UDP Bridge to AI Server
After=network-online.target pinky-bringup.service
Requires=pinky-bringup.service
Wants=robot-camera.service

[Service]
Type=simple
User=pinky
EnvironmentFile=-/etc/robot_runtime.env
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/pinky/pinky_pro/install/setup.bash && source /home/pinky/ros-repo-1/robot/jazzy_ws/install/setup.bash && export ROS_DOMAIN_ID=${ROS_DOMAIN_ID}; exec ros2 launch communication_node bridge.launch.py image_topic:=${IMAGE_TOPIC} camera_source:=${CAMERA_SOURCE:-topic} ai_server_ip:=${AI_SERVER_IP} ai_server_port:=${AI_SERVER_PORT} encoding_mode:=${ENCODING_MODE} udp_payload_max:=${UDP_PAYLOAD_MAX} max_fps:=${MAX_FPS} resize_width:=${RESIZE_WIDTH} resize_height:=${RESIZE_HEIGHT} rotate_180:=${ROTATE_180:-false} jpeg_quality:=${JPEG_QUALITY} udp_warn_throttle_sec:=${UDP_WARN_THROTTLE_SEC:-5.0} tx_stats_log_period_sec:=${TX_STATS_LOG_PERIOD_SEC:-5.0} frame_id_seed:=${FRAME_ID_SEED:--1} ai_link_topic:=/${ROBOT_NS}/ai_link ai_healthcheck_enabled:=${AI_HEALTHCHECK_ENABLED} ai_healthcheck_mode:=${AI_HEALTHCHECK_MODE} ai_healthcheck_port:=${AI_HEALTHCHECK_PORT} ai_healthcheck_period_sec:=${AI_HEALTHCHECK_PERIOD_SEC} ai_healthcheck_timeout_sec:=${AI_HEALTHCHECK_TIMEOUT_SEC} ai_healthcheck_fail_threshold:=${AI_HEALTHCHECK_FAIL_THRESHOLD} ai_healthcheck_recover_threshold:=${AI_HEALTHCHECK_RECOVER_THRESHOLD} skip_stream_when_ai_dead:=${SKIP_STREAM_WHEN_AI_DEAD} ai_dead_log_period_sec:=${AI_DEAD_LOG_PERIOD_SEC} rpicam_cmd:=${RPICAM_CMD:-rpicam-vid} rpicam_still_cmd:=${RPICAM_STILL_CMD:-rpicam-still} rpicam_restart_backoff_sec:=${RPICAM_RESTART_BACKOFF_SEC:-2.0} rpicam_use_system_libs:=${RPICAM_USE_SYSTEM_LIBS:-true} rpicam_awb_mode:=${RPICAM_AWB_MODE:-auto} rpicam_awb_autoselect:=${RPICAM_AWB_AUTOSELECT:-false} rpicam_awb_candidates:=${RPICAM_AWB_CANDIDATES:-fluorescent,daylight,cloudy,tungsten,indoor} rpicam_awb_probe_width:=${RPICAM_AWB_PROBE_WIDTH:-640} rpicam_awb_probe_height:=${RPICAM_AWB_PROBE_HEIGHT:-360} rpicam_awb_probe_timeout_ms:=${RPICAM_AWB_PROBE_TIMEOUT_MS:-1200}'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
