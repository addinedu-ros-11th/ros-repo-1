ROS_DOMAIN_ID=88
ROBOT_NS=robot_1
ROBOT_ID=1
MAP_PATH=/home/pinky/my_map.yaml

# Camera publisher (robot-camera.service)
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FPS=8
IMAGE_TOPIC=/camera/image_raw
CAMERA_SOURCE=rpicam
RPICAM_CMD=/usr/local/bin/rpicam-vid
RPICAM_RESTART_BACKOFF_SEC=2.0
RPICAM_USE_SYSTEM_LIBS=true

# UDP bridge (robot-udp-bridge.service)
AI_SERVER_IP=192.168.1.15
AI_SERVER_PORT=54321
ENCODING_MODE=mjpeg
UDP_PAYLOAD_MAX=1400
MAX_FPS=8.0
RESIZE_WIDTH=640
RESIZE_HEIGHT=360
JPEG_QUALITY=70

# AI link healthcheck
AI_HEALTHCHECK_ENABLED=true
AI_HEALTHCHECK_MODE=tcp_port
AI_HEALTHCHECK_PORT=50052
AI_HEALTHCHECK_PERIOD_SEC=2.0
AI_HEALTHCHECK_TIMEOUT_SEC=0.4
AI_HEALTHCHECK_FAIL_THRESHOLD=3
AI_HEALTHCHECK_RECOVER_THRESHOLD=1
SKIP_STREAM_WHEN_AI_DEAD=true
AI_DEAD_LOG_PERIOD_SEC=30.0
